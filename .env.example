# ──────────────────────────────────────────────────────────────
# Nexo — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# Database (Neon serverless Postgres for dev/staging)
DATABASE_URL=

# Auth — Clerk (SMS OTP primary)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Storage — Cloudflare R2 (S3-compatible)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ph-documents-prod

# Payments — Wompi (sandbox: https://sandbox.wompi.co/v1)
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_KEY=
WOMPI_INTEGRITY_KEY=
# Secret for recurring (tokenized) payment mandates — Phase 9.1
WOMPI_RECURRING_SECRET=

# Iris AI — Groq (free tier: https://console.groq.com)
GROQ_API_KEY=

# ── Notifications (Phase 17/19) — all optional; graceful no-op when empty ──
# Email — Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Nexo <notificaciones@tudominio.co>"
# WhatsApp + SMS — Twilio. WhatsApp needs a Meta-approved template + number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=   # e.g. 573001112233 (no 'whatsapp:' prefix)
TWILIO_SMS_FROM=        # e.g. +13105551234

# ── Integrations (Phase 19) — per design-partner; graceful no-op when empty ──
HUBSPOT_TOKEN=          # HubSpot private-app token
SIIGO_USERNAME=         # Siigo accounting API
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=       # registered with Siigo
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_RSA_PRIVATE_KEY=

# Queue / cache — Redis (Upstash for dev: rediss://default:PASSWORD@HOST:PORT)
REDIS_URL=

# Cédula encryption (AES-256-GCM). Must be exactly 32 bytes, hex-encoded (64 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Asamblea vote integrity — secret mixed into vote_hash (SHA-256). Any long random string.
VOTE_SECRET=

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Web client calls the API from the browser, so it needs the public variant (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Access control (2026-11) ──
# Clerk user ids of the Nexo team (comma-separated). Only they can create conjuntos.
PLATFORM_ADMIN_USER_IDS=
# true = anyone signed in can create a conjunto and become its admin (old behaviour)
ALLOW_SELF_SERVE_SIGNUP=false
# Extra web origins allowed by CORS (custom domains), comma-separated
CORS_EXTRA_ORIGINS=
# Monthly cuota generation on day 1 (set false on a demo/staging API)
BILLING_CRON_ENABLED=true
