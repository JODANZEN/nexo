// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN // Platform operator (your team)
  ADMIN // Administrador del Conjunto
  REVISOR_FISCAL // Read-only financial auditor
  RESIDENT // Propietario or Arrendatario
  GUARD // Portero
  STAFF // Operations staff (maintenance, housekeeping) — works assigned tickets
}

enum OccupancyType {
  OWNER // Propietario living in the unit
  OWNER_ABSENT // Propietario not living there (renting it out)
  TENANT // Arrendatario
}

enum DocumentVisibility {
  ADMIN_ONLY
  UNIT_OWNER
  UNIT_OCCUPANT
  ALL_RESIDENTS
  PUBLIC
}

enum DocumentStatus {
  PENDING_UPLOAD
  ACTIVE
  SUPERSEDED // Replaced by a newer version
  DELETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PSE
  NEQUI
  DAVIPLATA
  CARD // Tokenized card (recurring mandate)
  AUTO_CHARGE // System-initiated charge against a saved RecurringMandate
  CASH // Paid in person to admin
  BANK_TRANSFER
}

enum VisitorStatus {
  PRE_AUTHORIZED // QR generated by resident, not yet used
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  REVOKED
}

enum PqrCategory {
  NOISE
  MAINTENANCE
  SECURITY
  FINANCIAL
  COEXISTENCE
  OTHER
}

enum PqrStatus {
  OPEN
  IN_REVIEW
  AWAITING_RESIDENT // blocked on the resident — SLA clock paused
  RESOLVED
  CLOSED
}

// Phase 17 — ticket priority (impact × urgency) and scope taxonomy.
enum PqrPriority {
  P1 // critical
  P2 // high
  P3 // normal (default)
  P4 // low
}

enum PqrScope {
  IN_UNIT // inside a resident's apartment
  FACILITY // common areas / installations
  INTERNAL_OPS // internal management / staff
}

enum AsambleaStatus {
  SCHEDULED
  QUORUM_OPEN // Accepting check-ins, counting toward quorum
  IN_PROGRESS
  VOTING_CLOSED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// TENANT ROOT: CONJUNTO
// Represents one Propiedad Horizontal entity.
// All other tables scope to this via conjunto_id.
// ─────────────────────────────────────────────

model Conjunto {
  id                String   @id @default(cuid())
  name              String // "Conjunto Residencial El Nogal"
  nit               String   @unique // Colombian tax ID for the PH entity
  address           String
  city              String
  department        String
  reglamento_ph_url String? // Presigned URL ref to reglamento document
  total_units       Int
  // ── Billing engine addendum (docs/execution.md) ──
  mora_rate         Decimal  @default(0.0150) @db.Decimal(5, 4)
  pronto_pago_rate  Decimal  @default(0.0500) @db.Decimal(5, 4)
  // ── Phase 14 — Entitlements / tiering ──
  plan              String   @default("BASIC") // BASIC | PRO | PREMIUM
  plan_status       String   @default("ACTIVE") // ACTIVE | TRIAL | PAST_DUE
  feature_overrides Json? // per-building grants/trials: { "<featureKey>": { until?: ISO } }
  // ── Operations (2026-11) — per-client ticket targets + business hours ──
  sla_config        Json? // { P1: { firstResponse, resolution, businessHours }, ... } (hours)
  business_hours    Json? // { days: [1..6], start: "08:00", end: "18:00", holidays: ["2026-12-08"] }
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  // ── Phase 9 — Parking module ──
  parking_rate_per_hour Decimal @default(3500) @db.Decimal(12, 2)

  units                Unit[]
  users                User[]
  documents            Document[]
  payments             Payment[]
  pqrs                 Pqr[]
  asambleas            Asamblea[]
  visitor_logs         VisitorLog[]
  delivery_logs        DeliveryLog[]
  billing_periods      BillingPeriod[]
  consent_records      ConsentRecord[]
  audit_logs           AuditLog[]
  recurring_mandates   RecurringMandate[]
  parking_spots        ParkingSpot[]
  parking_sessions     ParkingSession[]
  // ── Phase 12 — Dashboard feature buildout ──
  amenities            Amenity[]
  reservations         Reservation[]
  providers            Provider[]
  announcements        Announcement[]
  room_types           RoomType[]
  routing_rules        PqrRoutingRule[]
  entry_authorizations EntryAuthorization[]
  maintenance_plans    MaintenancePlan[]

  @@map("conjuntos")
}

// ─────────────────────────────────────────────
// UNIT (Apartamento / Casa / Local)
// Represents a single coproperty unit.
// ─────────────────────────────────────────────

model Unit {
  id            String   @id @default(cuid())
  conjunto_id   String
  unit_number   String // "301", "Casa 12", "Local 3"
  floor         Int?
  tower         String? // "Torre A", "Torre B"
  // coeficiente: determines voting weight and admin fee share
  // Stored as DECIMAL to avoid floating-point errors
  coeficiente   Decimal  @db.Decimal(10, 6)
  monthly_fee   Decimal  @db.Decimal(12, 2) // COP, auto-computed from coeficiente
  is_commercial Boolean  @default(false)
  // ── Phase 18 — room-type catalog (student residences: 14 types @ City U) ──
  room_type_id  String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  conjunto           Conjunto           @relation(fields: [conjunto_id], references: [id])
  room_type          RoomType?          @relation(fields: [room_type_id], references: [id])
  occupancies        UnitOccupancy[]
  documents          Document[]
  payments           Payment[]
  pqrs               Pqr[]
  visitor_logs       VisitorLog[]
  delivery_logs      DeliveryLog[]
  asamblea_votes     AsambleaVote[]
  charges            Charge[]
  inspections        Inspection[]
  recurring_mandates RecurringMandate[]
  parking_spots      ParkingSpot[]

  @@unique([conjunto_id, unit_number])
  @@index([conjunto_id])
  @@map("units")
}

// ─────────────────────────────────────────────
// USER
// Platform users. A person can be linked to
// multiple units (e.g., owns two apartments).
// ─────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  conjunto_id      String
  external_auth_id String?  @unique // Clerk user ID or Auth.js session ref
  email            String?
  phone            String // Primary auth method in Colombia (+57...)
  full_name        String
  cedula_hash      String? // SHA-256 hash of cédula — for identity checks only, never raw
  role             UserRole
  is_active        Boolean  @default(true)
  push_token       String? // FCM / APNs token for push notifications
  team             String? // STAFF team label: "Mantenimiento", "Aseo", "Recepción"
  invite_sent_at   DateTime? // last invitation SMS/WhatsApp handed to the provider (resend cooldown)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relations
  conjunto             Conjunto             @relation(fields: [conjunto_id], references: [id])
  occupancies          UnitOccupancy[]
  documents_uploaded   Document[]           @relation("UploadedBy")
  pqrs_submitted       Pqr[]                @relation("SubmittedBy")
  pqrs_assigned        Pqr[]                @relation("AssignedTo")
  consent_records      ConsentRecord[]
  audit_logs           AuditLog[]
  asamblea_attendances AsambleaAttendance[]
  asamblea_votes       AsambleaVote[]
  visitor_qr_codes     VisitorQrCode[]

  @@index([conjunto_id])
  @@index([phone])
  @@map("users")
}

// ─────────────────────────────────────────────
// UNIT OCCUPANCY
// Resolves the owner/tenant relationship.
// A unit may have one active OWNER and one
// active TENANT simultaneously. History is kept.
// ─────────────────────────────────────────────

model UnitOccupancy {
  id                String        @id @default(cuid())
  unit_id           String
  user_id           String
  occupancy_type    OccupancyType
  started_at        DateTime
  ended_at          DateTime? // NULL = currently active
  // Contract reference for tenants
  lease_document_id String?

  // Relations
  unit           Unit         @relation(fields: [unit_id], references: [id])
  user           User         @relation(fields: [user_id], references: [id])
  lease_document Document?    @relation(fields: [lease_document_id], references: [id])
  inspections    Inspection[]

  // Enforce: max one active OWNER and one active TENANT per unit
  @@unique([unit_id, occupancy_type, ended_at])
  @@index([unit_id])
  @@index([user_id])
  @@map("unit_occupancies")
}

// ─────────────────────────────────────────────
// DOCUMENT (Secure PDF Storage)
// Metadata only. Actual file lives in R2.
// ─────────────────────────────────────────────

model Document {
  id               String             @id @default(cuid())
  conjunto_id      String
  unit_id          String? // NULL = conjunto-wide document (e.g., Acta)
  uploaded_by_id   String
  title            String
  description      String?
  // r2_key: the full object path in R2 — never exposed to clients
  r2_key           String             @unique
  mime_type        String             @default("application/pdf")
  file_size_bytes  Int
  visibility       DocumentVisibility @default(ADMIN_ONLY)
  status           DocumentStatus     @default(ACTIVE)
  // For versioning: superseded documents point to their replacement
  superseded_by_id String?
  // Habeas Data: track if this doc contains personal data
  contains_pii     Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  // Relations
  conjunto             Conjunto            @relation(fields: [conjunto_id], references: [id])
  unit                 Unit?               @relation(fields: [unit_id], references: [id])
  uploaded_by          User                @relation("UploadedBy", fields: [uploaded_by_id], references: [id])
  superseded_by        Document?           @relation("DocumentVersions", fields: [superseded_by_id], references: [id])
  previous_versions    Document[]          @relation("DocumentVersions")
  occupancies_as_lease UnitOccupancy[]
  access_logs          DocumentAccessLog[]
  asamblea_acta        Asamblea?           @relation("ActaDocument")

  @@index([conjunto_id])
  @@index([unit_id])
  @@map("documents")
}

// Audit trail: every presigned URL generation is logged
model DocumentAccessLog {
  id          String   @id @default(cuid())
  document_id String
  accessed_by String // userId
  accessed_at DateTime @default(now())
  ip_address  String?
  user_agent  String?

  document Document @relation(fields: [document_id], references: [id])

  @@index([document_id])
  @@map("document_access_logs")
}

// ─────────────────────────────────────────────
// BILLING PERIOD
// Monthly billing cycle for the conjunto
// ─────────────────────────────────────────────

model BillingPeriod {
  id               String   @id @default(cuid())
  conjunto_id      String
  period_month     Int // 1–12
  period_year      Int
  due_date         DateTime
  late_fee_rate    Decimal  @db.Decimal(5, 4) // e.g., 0.0150 = 1.5% monthly mora
  // ── Billing engine addendum (docs/execution.md) ──
  pronto_pago_rate Decimal  @default(0.0500) @db.Decimal(5, 4)
  is_closed        Boolean  @default(false)
  created_at       DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  charges  Charge[]

  @@unique([conjunto_id, period_month, period_year])
  @@map("billing_periods")
}

// Individual charge per unit per period
model Charge {
  id                String   @id @default(cuid())
  unit_id           String
  billing_period_id String
  base_amount       Decimal  @db.Decimal(12, 2) // COP
  late_fee_amount   Decimal  @default(0) @db.Decimal(12, 2)
  total_amount      Decimal  @db.Decimal(12, 2)
  // ── Billing engine addendum (docs/execution.md) ──
  paid_amount       Decimal  @default(0) @db.Decimal(12, 2)
  pronto_pago_rate  Decimal? @db.Decimal(5, 4) // Snapshot at time of period creation
  description       String?
  created_at        DateTime @default(now())

  unit           Unit          @relation(fields: [unit_id], references: [id])
  billing_period BillingPeriod @relation(fields: [billing_period_id], references: [id])
  payments       Payment[]

  @@index([unit_id])
  @@map("charges")
}

// ─────────────────────────────────────────────
// PAYMENT
// Tracks a payment transaction against a charge.
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  conjunto_id       String
  unit_id           String
  charge_id         String? // NULL for manual/partial payments
  amount            Decimal       @db.Decimal(12, 2) // COP
  currency          String        @default("COP")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  // Payment gateway fields (Wompi / ePayco)
  gateway_name      String? // "wompi" | "epayco"
  gateway_reference String?       @unique // Gateway transaction ID
  gateway_payload   Json? // Raw webhook payload from gateway
  pse_bank_code     String? // PSE-specific: bank selected by user
  nequi_phone       String? // Nequi: phone number used
  paid_at           DateTime?
  // Phase 9 — Contabilidad: set when matched against a bank statement row
  reconciled_at     DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  // Relations
  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  unit     Unit     @relation(fields: [unit_id], references: [id])
  charge   Charge?  @relation(fields: [charge_id], references: [id])

  @@index([conjunto_id])
  @@index([unit_id])
  @@index([gateway_reference])
  @@map("payments")
}

// ─────────────────────────────────────────────
// PQR (Petición, Queja, Reclamo)
// ─────────────────────────────────────────────

model Pqr {
  id                     String      @id @default(cuid())
  conjunto_id            String
  unit_id                String?
  submitted_by_id        String
  assigned_to_id         String?
  category               PqrCategory
  status                 PqrStatus   @default(OPEN)
  // ── Phase 17 — fast-ticket loop (SLA, priority, taxonomy, routing) ──
  priority               PqrPriority @default(P3)
  scope                  PqrScope    @default(IN_UNIT)
  first_response_due_at  DateTime?
  resolution_due_at      DateTime?
  first_responded_at     DateTime?
  sla_breached           Boolean     @default(false)
  awaiting_since         DateTime? // set when status → AWAITING_RESIDENT
  paused_ms              Int         @default(0) // accumulated paused (resident-blocked) time
  escalation_level       Int         @default(0) // 0=none, 1=assignee nudged, 2=supervisor, 3=breach
  maintenance_plan_id    String? // set when created by a preventive-maintenance plan
  first_response_alerted Boolean     @default(false) // first-response breach already notified
  title                  String
  description            String
  attachments            String[] // Array of r2_keys (photos, etc.)
  resolved_at            DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  conjunto             Conjunto             @relation(fields: [conjunto_id], references: [id])
  unit                 Unit?                @relation(fields: [unit_id], references: [id])
  submitted_by         User                 @relation("SubmittedBy", fields: [submitted_by_id], references: [id])
  assigned_to          User?                @relation("AssignedTo", fields: [assigned_to_id], references: [id])
  comments             PqrComment[]
  entry_authorizations EntryAuthorization[]
  maintenance_plan     MaintenancePlan?     @relation(fields: [maintenance_plan_id], references: [id], onDelete: SetNull)

  @@index([conjunto_id])
  @@index([assigned_to_id, status])
  @@map("pqrs")
}

model PqrComment {
  id          String   @id @default(cuid())
  pqr_id      String
  author_id   String
  body        String
  is_internal Boolean  @default(false) // Admin-only notes
  created_at  DateTime @default(now())

  pqr Pqr @relation(fields: [pqr_id], references: [id])

  @@index([pqr_id])
  @@map("pqr_comments")
}

// ─────────────────────────────────────────────
// ASAMBLEA (HOA Assembly + Voting)
// ─────────────────────────────────────────────

model Asamblea {
  id                String         @id @default(cuid())
  conjunto_id       String
  title             String // "Asamblea Ordinaria 2025"
  type              String // "ORDINARIA" | "EXTRAORDINARIA"
  scheduled_at      DateTime
  quorum_percentage Decimal        @db.Decimal(5, 2) // e.g., 50.01 (%)
  quorum_reached_at DateTime?
  status            AsambleaStatus @default(SCHEDULED)
  // Auto-generated Acta PDF after completion
  acta_document_id  String?        @unique
  meeting_url       String? // Zoom/Meet link
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  conjunto      Conjunto             @relation(fields: [conjunto_id], references: [id])
  acta_document Document?            @relation("ActaDocument", fields: [acta_document_id], references: [id])
  agenda_items  AsambleaAgendaItem[]
  attendances   AsambleaAttendance[]
  votes         AsambleaVote[]

  @@index([conjunto_id])
  @@map("asambleas")
}

model AsambleaAgendaItem {
  id               String    @id @default(cuid())
  asamblea_id      String
  order            Int // Agenda order
  title            String
  description      String?
  voting_open      Boolean   @default(false)
  voting_closed_at DateTime?
  created_at       DateTime  @default(now())

  asamblea Asamblea       @relation(fields: [asamblea_id], references: [id])
  votes    AsambleaVote[]

  @@map("asamblea_agenda_items")
}

model AsambleaAttendance {
  id                String   @id @default(cuid())
  asamblea_id       String
  user_id           String
  unit_id           String
  // Proxy: this user is voting on behalf of the real owner
  is_proxy          Boolean  @default(false)
  proxy_for_user_id String?
  // poder_document_id: the scanned poder PDF giving proxy rights
  poder_document_id String?
  coeficiente       Decimal  @db.Decimal(10, 6) // Snapshot at time of assembly
  checked_in_at     DateTime @default(now())

  asamblea Asamblea @relation(fields: [asamblea_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@unique([asamblea_id, unit_id]) // One attendance record per unit per assembly
  @@map("asamblea_attendances")
}

model AsambleaVote {
  id             String   @id @default(cuid())
  asamblea_id    String
  agenda_item_id String
  user_id        String
  unit_id        String
  vote_value     String // "SI" | "NO" | "ABSTENCION"
  coeficiente    Decimal  @db.Decimal(10, 6) // Vote weight
  // Integrity: SHA-256 hash of (agenda_item_id + unit_id + vote_value + secret)
  vote_hash      String
  voted_at       DateTime @default(now())

  asamblea    Asamblea           @relation(fields: [asamblea_id], references: [id])
  agenda_item AsambleaAgendaItem @relation(fields: [agenda_item_id], references: [id])
  user        User               @relation(fields: [user_id], references: [id])
  unit        Unit               @relation(fields: [unit_id], references: [id])

  @@unique([agenda_item_id, unit_id]) // One vote per unit per agenda item
  @@index([asamblea_id])
  @@map("asamblea_votes")
}

// ─────────────────────────────────────────────
// PORTERÍA: VISITOR & DELIVERY MANAGEMENT
// ─────────────────────────────────────────────

// QR codes generated by residents for expected visitors
model VisitorQrCode {
  id            String        @id @default(cuid())
  conjunto_id   String
  unit_id       String
  created_by_id String // The resident who generated it
  visitor_name  String
  valid_from    DateTime
  valid_until   DateTime
  // Token embedded in QR — validated server-side, never decoded client-side
  qr_token      String        @unique @default(cuid())
  status        VisitorStatus @default(PRE_AUTHORIZED)
  created_at    DateTime      @default(now())

  created_by  User        @relation(fields: [created_by_id], references: [id])
  visitor_log VisitorLog?

  @@index([qr_token])
  @@map("visitor_qr_codes")
}

// Full visitor log entry (for both QR and walk-in visitors)
model VisitorLog {
  id                   String        @id @default(cuid())
  conjunto_id          String
  unit_id              String
  qr_code_id           String?       @unique // Present if entry via QR
  visitor_name         String
  // cedula_encrypted: AES-256-GCM encrypted at app layer
  // Key stored in AWS Secrets Manager — never in DB
  cedula_encrypted     String?
  // Habeas Data: consent was shown and accepted by visitor at guard tablet
  habeas_data_accepted Boolean       @default(false)
  status               VisitorStatus
  guard_user_id        String? // Guard who logged the entry
  checked_in_at        DateTime?
  checked_out_at       DateTime?
  // Auto-purge: records deleted after 30 days (BullMQ scheduled job)
  purge_after          DateTime      @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  conjunto Conjunto       @relation(fields: [conjunto_id], references: [id])
  unit     Unit           @relation(fields: [unit_id], references: [id])
  qr_code  VisitorQrCode? @relation(fields: [qr_code_id], references: [id])

  @@index([conjunto_id])
  @@index([unit_id])
  @@map("visitor_logs")
}

// Package/delivery tracking
model DeliveryLog {
  id                String    @id @default(cuid())
  conjunto_id       String
  unit_id           String
  carrier           String // "rappi" | "mercadolibre" | "servientrega" | "other"
  tracking_number   String?
  description       String?
  // r2_key to the photo taken by guard (encrypted in R2)
  package_photo_key String?
  guard_user_id     String?
  received_at       DateTime  @default(now())
  // Resident confirms pickup in-app
  picked_up_by_id   String?
  picked_up_at      DateTime?

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  unit     Unit     @relation(fields: [unit_id], references: [id])

  @@index([conjunto_id])
  @@index([unit_id])
  @@map("delivery_logs")
}

// ─────────────────────────────────────────────
// COMPLIANCE & AUDIT
// ─────────────────────────────────────────────

model ConsentRecord {
  id             String   @id @default(cuid())
  conjunto_id    String
  user_id        String
  policy_version String // e.g., "v2.1"
  accepted_at    DateTime @default(now())
  ip_address     String?
  user_agent     String?

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@map("consent_records")
}

// Immutable audit trail for sensitive operations
model AuditLog {
  id          String   @id @default(cuid())
  conjunto_id String
  actor_id    String? // NULL for system events
  action      String // "document.accessed" | "payment.created" | "visitor.checkin"
  entity_type String // "Document" | "Payment" | "VisitorLog"
  entity_id   String
  metadata    Json? // Additional context (IP, before/after state)
  created_at  DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  actor    User?    @relation(fields: [actor_id], references: [id])

  @@index([conjunto_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// MOVE-IN INSPECTION (docs/execution.md Phase 4.2)
// Room-by-room condition capture with R2 photos.
// ─────────────────────────────────────────────

enum InspectionType {
  MOVE_IN
  MOVE_OUT
  ROUTINE
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  ADMIN_REVIEWED
}

model Inspection {
  id           String           @id @default(cuid())
  conjunto_id  String
  unit_id      String
  occupancy_id String // Tied to the UnitOccupancy it covers
  inspector_id String // User (resident or admin)
  type         InspectionType
  status       InspectionStatus @default(DRAFT)
  submitted_at DateTime?
  created_at   DateTime         @default(now())

  unit      Unit             @relation(fields: [unit_id], references: [id])
  occupancy UnitOccupancy    @relation(fields: [occupancy_id], references: [id])
  rooms     InspectionRoom[]

  @@index([conjunto_id])
  @@index([unit_id])
  @@map("inspections")
}

model InspectionRoom {
  id             String   @id @default(cuid())
  inspection_id  String
  room_name      String // "Sala", "Cocina", "Habitación Principal"
  overall_rating Int // 1–5
  notes          String?
  photo_r2_keys  String[] // Array of R2 object keys

  inspection Inspection       @relation(fields: [inspection_id], references: [id])
  items      InspectionItem[]

  @@index([inspection_id])
  @@map("inspection_rooms")
}

model InspectionItem {
  id        String  @id @default(cuid())
  room_id   String
  item_name String // "Paredes", "Piso", "Ventanas", "Interruptor"
  condition String // "BUENO" | "REGULAR" | "MALO" | "NO_APLICA"
  notes     String?

  room InspectionRoom @relation(fields: [room_id], references: [id])

  @@index([room_id])
  @@map("inspection_items")
}

// ─────────────────────────────────────────────
// PHASE 9.1 — RECURRING PAYMENT MANDATE (Wompi tokenized)
// Resident saves a payment source once; the monthly cron auto-charges it.
// ─────────────────────────────────────────────

model RecurringMandate {
  id              String   @id @default(cuid())
  conjunto_id     String
  unit_id         String
  wompi_source_id String // Wompi payment source token
  payment_method  String // CARD | NEQUI | PSE
  status          String   @default("ACTIVE") // ACTIVE | CANCELLED | FAILED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  unit     Unit     @relation(fields: [unit_id], references: [id])

  @@unique([unit_id, status])
  @@index([conjunto_id])
  @@map("recurring_mandates")
}

// ─────────────────────────────────────────────
// PHASE 9.2 — PARKING MODULE
// ─────────────────────────────────────────────

model ParkingSpot {
  id          String   @id @default(cuid())
  conjunto_id String
  spot_number String
  spot_type   String   @default("VISITOR") // RESIDENT | VISITOR
  unit_id     String? // assigned resident unit (null = visitor spot)
  created_at  DateTime @default(now())

  conjunto Conjunto         @relation(fields: [conjunto_id], references: [id])
  unit     Unit?            @relation(fields: [unit_id], references: [id])
  sessions ParkingSession[]

  @@unique([conjunto_id, spot_number])
  @@index([conjunto_id])
  @@map("parking_spots")
}

model ParkingSession {
  id             String    @id @default(cuid())
  conjunto_id    String
  spot_id        String
  license_plate  String
  visitor_name   String?
  unit_visited   String?
  entered_at     DateTime  @default(now())
  exited_at      DateTime?
  amount_charged Decimal?  @db.Decimal(12, 2)

  conjunto Conjunto    @relation(fields: [conjunto_id], references: [id])
  spot     ParkingSpot @relation(fields: [spot_id], references: [id])

  @@index([conjunto_id])
  @@index([spot_id])
  @@map("parking_sessions")
}

// ─────────────────────────────────────────────
// PHASE 12 — DASHBOARD FEATURE BUILDOUT
// Reservas (amenity booking), Proveedores, Anuncios.
// Comunidad / Reportes / Configuración need no new tables.
// ─────────────────────────────────────────────

model Amenity {
  id          String   @id @default(cuid())
  conjunto_id String
  name        String // "Salón social", "BBQ", "Gimnasio"
  description String?
  open_time   String? // "08:00"
  close_time  String? // "22:00"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  conjunto     Conjunto      @relation(fields: [conjunto_id], references: [id])
  reservations Reservation[]

  @@index([conjunto_id])
  @@map("amenities")
}

model Reservation {
  id               String   @id @default(cuid())
  conjunto_id      String
  amenity_id       String
  unit_id          String?
  reserved_by_id   String? // user id (no FK — denormalized name kept for display)
  reserved_by_name String?
  start_at         DateTime
  end_at           DateTime
  status           String   @default("ACTIVE") // ACTIVE | CANCELLED
  created_at       DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  amenity  Amenity  @relation(fields: [amenity_id], references: [id])

  @@index([conjunto_id])
  @@index([amenity_id])
  @@map("reservations")
}

model Provider {
  id          String   @id @default(cuid())
  conjunto_id String
  name        String
  category    String? // "Aseo", "Mantenimiento", "Seguridad"
  phone       String?
  email       String?
  notes       String?
  created_at  DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])

  @@index([conjunto_id])
  @@map("providers")
}

model Announcement {
  id            String   @id @default(cuid())
  conjunto_id   String
  title         String
  body          String
  pinned        Boolean  @default(false)
  created_by_id String? // user id (no FK)
  created_at    DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])

  @@index([conjunto_id])
  @@map("announcements")
}

// ─────────────────────────────────────────────
// PHASE 17 — NOTIFICATIONS (persisted in-app feed; multi-channel delivery)
// Scalar ids (no relations) so the notifier stays decoupled from every module.
// ─────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  conjunto_id String
  user_id     String // recipient (users.id)
  type        String // 'pqr.status' | 'pqr.assigned' | 'visitor.arrived' | ...
  title       String
  body        String?
  entity_type String? // 'Pqr' | 'VisitorLog' | ...
  entity_id   String?
  link        String? // deep-link path for the web/app
  read_at     DateTime?
  created_at  DateTime  @default(now())

  @@index([conjunto_id])
  @@index([user_id, read_at])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// PHASE 18 — ROOM-TYPE CATALOG
// A conjunto's room/unit types (e.g. student residence: Sencilla, Doble, Suite…).
// Units reference a type; drives inventory + per-type attributes/pricing.
// ─────────────────────────────────────────────

model RoomType {
  id          String   @id @default(cuid())
  conjunto_id String
  name        String // "Sencilla", "Doble", "Suite 2 ambientes"
  description String?
  capacity    Int? // occupants
  base_fee    Decimal? @db.Decimal(12, 2) // reference monthly fee for the type (COP)
  created_at  DateTime @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  units    Unit[]

  @@unique([conjunto_id, name])
  @@index([conjunto_id])
  @@map("room_types")
}

// ─────────────────────────────────────────────
// OPERATIONS (2026-11) — routing, entry authorization, preventive maintenance
// ─────────────────────────────────────────────

// Auto-assignment: first active rule (lowest sort_order) whose category/scope
// match (null = any) assigns the ticket to the least-loaded active candidate.
model PqrRoutingRule {
  id           String       @id @default(cuid())
  conjunto_id  String
  name         String
  category     PqrCategory?
  scope        PqrScope?
  assignee_ids String[] // users.id candidates (STAFF / ADMIN)
  sort_order   Int          @default(100)
  is_active    Boolean      @default(true)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])

  @@index([conjunto_id])
  @@map("pqr_routing_rules")
}

enum EntryAuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  USED
  CANCELLED
}

// Staff asks to enter a unit for a ticket; the resident approves in the portal
// or from a one-time link (SMS/WhatsApp). Portería sees approved, current ones.
model EntryAuthorization {
  id              String                   @id @default(cuid())
  conjunto_id     String
  pqr_id          String
  unit_id         String
  requested_by_id String // users.id
  decided_by_id   String? // users.id (null when decided via link)
  status          EntryAuthorizationStatus @default(PENDING)
  reason          String?
  window_start    DateTime
  window_end      DateTime
  token_hash      String                   @unique // sha256 of the one-time link token
  decided_at      DateTime?
  decision_note   String?
  used_at         DateTime?
  created_at      DateTime                 @default(now())

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  pqr      Pqr      @relation(fields: [pqr_id], references: [id])

  @@index([conjunto_id, status])
  @@index([pqr_id])
  @@map("entry_authorizations")
}

// Recurring preventive work (e.g. "Limpieza de tanques" every 6 months). A daily
// cron turns each due plan into a ticket and advances next_due_at.
model MaintenancePlan {
  id                String      @id @default(cuid())
  conjunto_id       String
  title             String
  description       String?
  scope             PqrScope    @default(FACILITY)
  priority          PqrPriority @default(P3)
  unit_id           String? // optional: a specific unit/room
  assigned_to_id    String? // users.id; null → routing rules decide
  interval_unit     String // DAY | WEEK | MONTH
  interval_count    Int         @default(1)
  next_due_at       DateTime
  lead_days         Int         @default(0) // create the ticket N days before it's due
  is_active         Boolean     @default(true)
  created_by_id     String // users.id — submitter of generated tickets
  last_generated_at DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  conjunto Conjunto @relation(fields: [conjunto_id], references: [id])
  pqrs     Pqr[]

  @@index([conjunto_id])
  @@index([is_active, next_due_at])
  @@map("maintenance_plans")
}
